# --- Project data, outputs, checkpoints (stored on Google Drive, not in repo) ---
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep

checkpoints/*
outputs/models/*
outputs/predictions/*
outputs/temporary/*
outputs/figures/*
!outputs/**/.gitkeep
!checkpoints/.gitkeep

# --- Experiments: keep configs/notes, ignore large artifacts ---
experiments/*/checkpoints/
experiments/*/predictions/
experiments/*/logs/*.log
experiments/*/wandb/
experiments/*/runs/

# --- Submissions: keep small CSVs, ignore large ones ---
# Submissions are committed by design (see submissions/.gitkeep)

# --- HuggingFace / model cache ---
.cache/
hf_cache/
hub/

# --- W&B / MLflow ---
wandb/
mlruns/
