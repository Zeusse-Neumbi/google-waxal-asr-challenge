# Example environment variables. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` (it is git-ignored).

# --- Hugging Face ---
HUGGING_FACE_HUB_TOKEN=

# --- Weights & Biases ---
WANDB_PROJECT=waxal-asr
WANDB_ENTITY=
WANDB_API_KEY=
WANDB_MODE=offline

# --- HF / Transformers cache (point at Drive on Colab) ---
HF_HOME=
TRANSFORMERS_CACHE=
HF_DATASETS_CACHE=

# --- Project data root (optional override) ---
WAXAL_DATA_ROOT=data

# --- Reproducibility ---
CUBLAS_WORKSPACE_CONFIG=:4096:8
